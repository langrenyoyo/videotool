<view class="page">
  <view class="intro">
    <view class="intro-kicker">任务提交</view>
    <view class="intro-text">{{task.content}}</view>
  </view>

  <view class="task-card">
    <view class="task-card-title">{{task.title}}</view>
    <view class="task-card-desc">{{task.form.desc}}</view>
  </view>

  <view class="form-card">
    <view class="field-title">选择项目<text class="required">*</text></view>
    <view class="field-desc">请选择本次提交对应的项目名称</view>
    <picker mode="selector" range="{{projectNames}}" value="{{selectedProjectIndex}}" bindchange="onProjectChange">
      <view class="select-row">
        <view class="select-text">{{selectedProjectName || '请选择项目名称'}}</view>
        <view class="select-arrow">›</view>
      </view>
    </picker>
  </view>

  <view class="form-card">
    <view class="field-title">{{task.form.gameIdImageTitle}}<text class="required">*</text></view>
    <view class="field-desc">{{task.form.gameIdImageTip}}</view>
    <view class="upload-row">
      <view class="upload-btn" bindtap="chooseGameIdImage">
        <view class="upload-icon">拍</view>
        <view class="upload-text">拍照上传</view>
      </view>
      <view class="upload-btn" bindtap="chooseGameIdFromAlbum">
        <view class="upload-icon">册</view>
        <view class="upload-text">相册选择</view>
      </view>
    </view>

    <view class="ai-box">
      <view class="ai-head">AI 自动识别</view>
      <view class="ai-grid">
        <view class="ai-label">{{task.form.gameIdFieldLabel}}</view>
        <input class="ai-input" value="{{gameId}}" placeholder="自动识别或手动填写" bindinput="onGameIdInput" />
      </view>
    </view>
  </view>

  <view class="form-card">
    <view class="field-title">{{task.form.orderImageTitle}}<text class="required">*</text></view>
    <view class="field-desc">{{task.form.orderImageTip}}</view>
    <view class="upload-row">
      <view class="upload-btn" bindtap="chooseOrderImage">
        <view class="upload-icon">拍</view>
        <view class="upload-text">拍照上传</view>
      </view>
      <view class="upload-btn" bindtap="chooseOrderFromAlbum">
        <view class="upload-icon">册</view>
        <view class="upload-text">相册选择</view>
      </view>
    </view>

    <view class="ai-box">
      <view class="ai-head">AI 自动识别</view>
      <view class="ai-grid">
        <view class="ai-label">{{task.form.orderFieldLabel}}</view>
        <input class="ai-input" value="{{orderNo}}" placeholder="自动识别或手动填写" bindinput="onOrderNoInput" />
      </view>
    </view>
  </view>

  <view class="form-card">
    <view class="field-title">{{task.form.videoTitle}}<text class="required">*</text></view>
    <view class="upload-row">
      <view class="upload-btn" bindtap="chooseVideoFromCamera">
        <view class="upload-icon">录</view>
        <view class="upload-text">拍摄上传</view>
      </view>
      <view class="upload-btn" bindtap="chooseVideoFromAlbum">
        <view class="upload-icon">册</view>
        <view class="upload-text">相册选择</view>
      </view>
    </view>
    <view wx:if="{{videoFileId}}" class="file-summary video-upload-summary">
      <view class="file-line">已上传充值视频</view>
    </view>
    <view wx:if="{{gameIdImageFileId || orderImageFileId}}" class="file-summary">
      <view wx:if="{{gameIdImageFileId}}" class="file-line">已上传ID截图</view>
      <view wx:if="{{orderImageFileId}}" class="file-line">已上传订单截图</view>
    </view>
    <button class="primary-btn submit-btn" loading="{{submitting}}" disabled="{{submitting || assetUploading}}" bindtap="submit">{{task.form.submitButtonText}}</button>
    <view class="submit-tip">{{task.form.submitTip}}</view>
  </view>

  <view wx:if="{{assetUploading}}" class="upload-mask">
    <view class="upload-mask-panel">
      <view class="upload-mask-title">{{uploadMaskText}}</view>
      <view class="upload-mask-text">上传完成后才能提交，请保持页面停留</view>
    </view>
  </view>
</view>
