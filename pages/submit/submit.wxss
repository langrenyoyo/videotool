.intro {
  padding: 6rpx 4rpx 22rpx;
}

.intro-kicker {
  color: #007aff;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 0;
  margin-bottom: 8rpx;
}

.intro-text {
  color: #1d1d1f;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.55;
}

.task-card,
.form-card {
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(60, 60, 67, 0.1);
  border-radius: 16rpx;
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
  margin-bottom: 18rpx;
  padding: 24rpx;
}

.task-card-title {
  color: #1d1d1f;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.35;
  margin-bottom: 10rpx;
}

.task-card-desc {
  color: rgba(60, 60, 67, 0.7);
  font-size: 25rpx;
  line-height: 1.55;
}

.field-title {
  color: #1d1d1f;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.required {
  color: #ff3b30;
  margin-left: 6rpx;
}

.field-desc {
  color: rgba(60, 60, 67, 0.62);
  font-size: 24rpx;
  line-height: 1.45;
  margin-top: 8rpx;
}

.select-row {
  align-items: center;
  background: rgba(118, 118, 128, 0.1);
  border-radius: 14rpx;
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
  min-height: 78rpx;
  padding: 0 20rpx;
}

.select-text {
  color: #1d1d1f;
  font-size: 27rpx;
  font-weight: 600;
}

.select-arrow {
  color: rgba(60, 60, 67, 0.42);
  font-size: 46rpx;
  line-height: 1;
}

.upload-row {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}

.upload-btn {
  align-items: center;
  background: rgba(118, 118, 128, 0.1);
  border-radius: 14rpx;
  display: flex;
  flex: 1;
  gap: 10rpx;
  justify-content: center;
  min-height: 92rpx;
}

.upload-icon {
  align-items: center;
  background: #ffffff;
  border-radius: 50%;
  color: #007aff;
  display: flex;
  font-size: 22rpx;
  font-weight: 700;
  height: 42rpx;
  justify-content: center;
  width: 42rpx;
}

.upload-text {
  color: #1d1d1f;
  font-size: 26rpx;
  font-weight: 600;
}

.ai-box {
  background: rgba(0, 122, 255, 0.08);
  border-radius: 16rpx;
  margin-top: 16rpx;
  overflow: hidden;
}

.ai-head {
  color: #007aff;
  font-size: 24rpx;
  font-weight: 700;
  padding: 16rpx 18rpx 8rpx;
}

.ai-grid {
  align-items: center;
  display: flex;
  padding: 8rpx 14rpx 16rpx;
}

.ai-label {
  color: rgba(60, 60, 67, 0.72);
  flex: 0 0 150rpx;
  font-size: 25rpx;
  font-weight: 600;
}

.ai-input {
  background: #ffffff;
  border-radius: 12rpx;
  box-sizing: border-box;
  flex: 1;
  font-size: 26rpx;
  height: 68rpx;
  padding: 0 18rpx;
}

.ai-status {
  color: #007aff;
  font-size: 24rpx;
  padding: 0 18rpx 16rpx;
}

.file-summary {
  background: rgba(52, 199, 89, 0.1);
  border-radius: 14rpx;
  margin-top: 18rpx;
  padding: 14rpx 18rpx;
}

.video-entry {
  background: rgba(0, 122, 255, 0.06);
  border: 1rpx solid rgba(0, 122, 255, 0.14);
  border-radius: 14rpx;
  margin-top: 18rpx;
  padding: 18rpx;
}

.video-entry-title {
  color: #1d1d1f;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
}

.video-entry-row {
  margin-top: 14rpx;
}

.file-line {
  color: #1f7a3a;
  font-size: 24rpx;
  line-height: 1.6;
}

.submit-btn {
  height: 76rpx;
  line-height: 76rpx;
  margin-top: 18rpx;
}

.submit-tip {
  color: rgba(60, 60, 67, 0.58);
  font-size: 22rpx;
  line-height: 1.5;
  margin-top: 12rpx;
  text-align: center;
}

.upload-mask {
  align-items: center;
  background: rgba(0, 0, 0, 0.42);
  bottom: 0;
  display: flex;
  left: 0;
  justify-content: center;
  position: fixed;
  right: 0;
  top: 0;
  z-index: 999;
}

.upload-mask-panel {
  background: #ffffff;
  border-radius: 18rpx;
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.2);
  box-sizing: border-box;
  margin: 0 48rpx;
  padding: 34rpx 32rpx;
  text-align: center;
  width: 100%;
}

.upload-mask-title {
  color: #1d1d1f;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.3;
}

.upload-mask-text {
  color: rgba(60, 60, 67, 0.72);
  font-size: 24rpx;
  line-height: 1.5;
  margin-top: 12rpx;
}
