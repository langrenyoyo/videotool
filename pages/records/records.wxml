<view class="page">
  <view wx:if="{{records.length === 0}}" class="panel empty">
    <view class="empty-icon">⌁</view>
    <view class="empty-title">暂无提交记录</view>
    <view class="muted empty-text">提交任务后会在这里显示审核状态。</view>
    <button class="primary-btn empty-btn" bindtap="goTask">返回任务</button>
  </view>

  <view wx:else>
    <view class="record panel" wx:for="{{records}}" wx:key="id">
      <view class="record-head">
        <view class="record-title">{{item.projectName || item.taskTitle}}</view>
        <view class="status">{{item.statusText}}</view>
      </view>
      <view class="record-line">项目名称：{{item.projectName || item.taskTitle}}</view>
      <view class="record-line">ID：{{item.gameId}}</view>
      <view class="record-line">订单号：{{item.orderNo}}</view>
      <view class="record-line muted">提交时间：{{item.createdAtText}}</view>
      <view wx:if="{{item.reviewRemark}}" class="record-line">审核备注：{{item.reviewRemark}}</view>
    </view>
  </view>
</view>
