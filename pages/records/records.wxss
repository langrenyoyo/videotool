.empty {
  padding: 52rpx 28rpx;
  text-align: center;
}

.empty-icon {
  align-items: center;
  background: rgba(118, 118, 128, 0.12);
  border-radius: 50%;
  color: rgba(60, 60, 67, 0.58);
  display: flex;
  font-size: 42rpx;
  height: 96rpx;
  justify-content: center;
  margin: 0 auto 20rpx;
  width: 96rpx;
}

.empty-title {
  color: #1d1d1f;
  font-size: 34rpx;
  font-weight: 800;
}

.empty-text {
  font-size: 25rpx;
  margin-top: 12rpx;
}

.empty-btn {
  height: 76rpx;
  line-height: 76rpx;
  margin-top: 32rpx;
}

.record {
  margin-bottom: 18rpx;
}

.record-head {
  align-items: flex-start;
  display: flex;
  gap: 16rpx;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.record-title {
  color: #1d1d1f;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.4;
}

.status {
  background: rgba(255, 149, 0, 0.14);
  border-radius: 999rpx;
  color: #9a5a00;
  flex: 0 0 auto;
  font-size: 23rpx;
  font-weight: 700;
  padding: 7rpx 14rpx;
}

.record-line {
  color: rgba(60, 60, 67, 0.78);
  line-height: 1.6;
  margin-top: 8rpx;
}

.path {
  word-break: break-all;
}
