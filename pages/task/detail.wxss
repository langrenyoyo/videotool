.hero {
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(60, 60, 67, 0.1);
  border-radius: 20rpx;
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.06);
  box-sizing: border-box;
  display: flex;
  gap: 22rpx;
  justify-content: space-between;
  padding: 30rpx;
}

.hero-main {
  min-width: 0;
}

.code-pill {
  background: rgba(118, 118, 128, 0.12);
  border-radius: 999rpx;
  color: rgba(60, 60, 67, 0.7);
  display: inline-flex;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 42rpx;
  padding: 0 16rpx;
}

.task-title {
  color: #1d1d1f;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.25;
  margin-top: 18rpx;
}

.hero-meta {
  color: rgba(60, 60, 67, 0.58);
  font-size: 24rpx;
  margin-top: 14rpx;
}

.amount-badge {
  align-self: flex-start;
  background: rgba(255, 149, 0, 0.12);
  border-radius: 16rpx;
  flex: 0 0 150rpx;
  padding: 14rpx 12rpx;
  text-align: center;
}

.amount-label {
  color: #9a5a00;
  font-size: 22rpx;
}

.amount-value {
  color: #1d1d1f;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.2;
  margin-top: 6rpx;
}

.notice-strip {
  align-items: flex-start;
  background: rgba(0, 122, 255, 0.1);
  border-radius: 16rpx;
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
}

.notice-dot {
  background: #007aff;
  border-radius: 50%;
  flex: 0 0 12rpx;
  height: 12rpx;
  margin-top: 13rpx;
  width: 12rpx;
}

.notice-text {
  color: #0b4f9f;
  font-size: 25rpx;
  line-height: 1.55;
}

.section,
.highlight-section {
  margin-top: 18rpx;
}

.section-head {
  align-items: center;
  display: flex;
  margin-bottom: 18rpx;
}

.section-title {
  color: #1d1d1f;
  font-size: 31rpx;
  font-weight: 800;
}

.content {
  color: rgba(60, 60, 67, 0.78);
  line-height: 1.75;
}

.primary-content {
  background: rgba(118, 118, 128, 0.09);
  border-radius: 14rpx;
  padding: 20rpx;
}

.timeline {
  display: grid;
  gap: 14rpx;
}

.step {
  align-items: flex-start;
  display: flex;
  gap: 16rpx;
}

.step-index {
  align-items: center;
  background: #007aff;
  border-radius: 50%;
  color: #ffffff;
  display: flex;
  flex: 0 0 44rpx;
  font-size: 24rpx;
  font-weight: 700;
  height: 44rpx;
  justify-content: center;
  width: 44rpx;
}

.step-body {
  background: rgba(118, 118, 128, 0.08);
  border-radius: 14rpx;
  flex: 1;
  padding: 16rpx 18rpx;
}

.step-title {
  color: rgba(60, 60, 67, 0.62);
  font-size: 23rpx;
  margin-bottom: 6rpx;
}

.step-text {
  color: #1d1d1f;
  line-height: 1.55;
}

.material-list {
  display: grid;
  gap: 12rpx;
}

.material {
  align-items: center;
  background: rgba(52, 199, 89, 0.1);
  border-radius: 14rpx;
  display: flex;
  gap: 14rpx;
  padding: 16rpx 18rpx;
}

.check {
  align-items: center;
  background: #34c759;
  border-radius: 50%;
  color: #ffffff;
  display: flex;
  flex: 0 0 32rpx;
  font-size: 22rpx;
  height: 32rpx;
  justify-content: center;
  width: 32rpx;
}

.material-text {
  color: #1f6d36;
  line-height: 1.5;
}

.warning {
  align-items: flex-start;
  display: flex;
  gap: 14rpx;
  margin-top: 14rpx;
}

.warning:first-of-type {
  margin-top: 0;
}

.warning-dot {
  background: #ff9500;
  border-radius: 50%;
  flex: 0 0 12rpx;
  height: 12rpx;
  margin-top: 15rpx;
  width: 12rpx;
}

.warning-text {
  color: #7a4a00;
  line-height: 1.55;
}

.actions {
  display: flex;
  gap: 14rpx;
  margin-top: 22rpx;
}

.action-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
}
