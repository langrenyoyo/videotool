page {
  background: #f2f2f7;
  color: #1d1d1f;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
  font-size: 28rpx;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 24rpx 24rpx 44rpx;
}

.panel {
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(60, 60, 67, 0.1);
  border-radius: 16rpx;
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
  padding: 26rpx;
}

.muted {
  color: rgba(60, 60, 67, 0.62);
}

.primary-btn {
  background: #007aff;
  border-radius: 14rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  padding-left: 22rpx;
  padding-right: 22rpx;
}

.primary-btn::after,
.secondary-btn::after {
  border: 0;
}

.secondary-btn {
  background: rgba(118, 118, 128, 0.12);
  border-radius: 14rpx;
  color: #007aff;
  font-size: 28rpx;
  font-weight: 600;
  padding-left: 22rpx;
  padding-right: 22rpx;
}
